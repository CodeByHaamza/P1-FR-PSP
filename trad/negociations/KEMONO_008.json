[
  {
    "id": "KEMONO.BIN:text:0711",
    "en": "   ME ANGRY... STEAM OUT OF EARS... ME AT{SAUT}MAXIMUM ANGER!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0712",
    "en": "  ＊whimper＊ IT OKAY TO DEAL WITH ME,{SAUT}YOU KNOW...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0713",
    "en": " YOU IGNORE ME THIS MUCH. ME GIVE UP.(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0714",
    "en": "   REIJI... ME HAVE BAD FEELING...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0715",
    "en": "AWOOO! YOU ANSWER. THAT ALONE MAKE ME{SAUT}HAPPY.(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0716",
    "en": "   AWOOO! IF YOU APOLOGIZE, ME CAN FORGIVE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0717",
    "en": "   ME ANGRY... LOUD SOUND... YOU GET EATEN{SAUT}WHOLE TWICE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0718",
    "en": "   ＊whimper＊ IT OKAY TO DEAL WITH ME,{SAUT}YOU KNOW...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0719",
    "en": " THEN ME NO MIND YOU...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0720",
    "en": " ＊whimper＊ THAT SILENCE SCARY...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0721",
    "en": "ME WILL TRY! SO YOU BE INTERESTED!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0722",
    "en": " YOU KNOW ME, YET YOU THREATEN. STUPID?{SAUT}HMM... WELL, ME HAVE PITY FOR STUPID.(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0723",
    "en": "   ME INTRODUCE. ME [FFF3]. ME [FFF0].{SAUT}ME NUMBER ONE!{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0724",
    "en": "{PAGE}SO... GIVE ME SOMETHING![FFF1](*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0725",
    "en": "WHY ME!? YOU NOT UNDERSTAND! THAT NOT{SAUT}INTENTION!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0726",
    "en": "   ME WORTHLESS!? WHO ARE YOU?(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0727",
    "en": "ME SERIOUS! YOU NOT UNDERSTAND, YOU{SAUT}NOT GOOD HUMAN!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0728",
    "en": "＊whimper＊ ME GO TO SLEEP...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0729",
    "en": "ROAAAAAR! ROAAAAAR! ROAAAAAAAAR!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0730",
    "en": "   ＊whimper＊ ME PUT UP WITH YOU...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0731",
    "en": "YOU WEIRD... YOU MAKE ME WEIRD TOO...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0732",
    "en": "  THEN NO YELL! YOU DISTURB EVERYONE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0733",
    "en": "YOU WANT TO KILL? NOT ME, RIGHT?(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0734",
    "en": "   YOU CHEAP... ME DISAPPOINTED...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0735",
    "en": "YOU IGNORE ME... THEN ME WATCH YOU FOR{SAUT}FUN. AWOOOO!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0736",
    "en": "EMOTIONS... HUMANS HAVE NO CONTROL.{SAUT}VERY DANGEROUS...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0737",
    "en": "  ME WAS SET UP! ROAAAAR! ME UPSET!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0738",
    "en": "  AWOOOO! ME HAPPY! VERY HAPPY!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0739",
    "en": "  YOU COLD. ME SAD...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0740",
    "en": "HMM... ME JUST WATCH. THAT OKAY,{SAUT}RIGHT...?(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0741",
    "en": " ME ATE!? WHEN DID ME EAT IT!? FUNNY...{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0742",
    "en": "{PAGE}HMM... WILL MOON FIT DOWN TOILET?(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0743",
    "en": "  YOU RIGHT! ME NOT THINKING HARD!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0744",
    "en": "   ＊whimper＊ EARTH? ...0THER SIDE?{SAUT}＊whimper＊ ME NOT GET IT...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0745",
    "en": " HIGH SCHOOL STUDENTS NOT GOOD! YOU ARE{SAUT}TRESSPASSING!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0746",
    "en": "   YOU NOT FACE OF WORKER MAN! ME HATE{SAUT}LIARS! ME HATE YOU!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0747",
    "en": "DEVIL SUMMONER? ME MET BEFORE? ME NOT{SAUT}REMEMBER... ANYWAY. THIS MY TERRITORY.{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0748",
    "en": "{PAGE}YOU BE ON GOOD BEHAVIOR.(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0749",
    "en": " OH, YOU HUMAN. THAT MAKE THINGS EASY.{SAUT}ME NOT WORRY!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0750",
    "en": "ME KNOW YOU! WE FRIENDS. ME NOT SO{SAUT}WORRIED NOW...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0751",
    "en": "  ＊whimper＊ WHO ARE YOU? UNKNOWN ENEMIES{SAUT}ARE SCARIEST...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0752",
    "en": " YOU ALONE ON THIS NICE NIGHT? THAT{SAUT}SOUND SAD...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0753",
    "en": "ME LUCKY! YOU LOOK TASTY! ER... FUN!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0754",
    "en": "   YOU RUIN MY HAPPINESS!{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0755",
    "en": "{PAGE}YOU NOT CONSIDERATE! ME GO FROM HAPPY{SAUT}TO NOT HAPPY!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0756",
    "en": "THEN ME EAT YOU IN ONE WHOLE PIECE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0757",
    "en": "YOU KINDA SQUARE... CORNERS PROBABLY{SAUT}HURT WHEN CHEWING...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0758",
    "en": "  ME ASK CIRCLE OR SQUARE! NO TRIANGLE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0759",
    "en": "  HMM... WE GET ALONG!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0760",
    "en": "   YOU TIMID! ME NOT REALLY LIKE SCARDY{SAUT}CAT GUYS...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0761",
    "en": "   YOU GREEDY... ＊whimper＊ HUMANS ALL SO{SAUT}SELFISH...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0762",
    "en": "   YOU DOING WELL! ME DOING WELL! AWOOO!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0763",
    "en": "  HMM... THAT NOT GOOD. IMPORTANT TO STAY{SAUT}HEALTHY...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0764",
    "en": " YOU WEAK? THEN ME EAT YOU WHOLE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0765",
    "en": "   YOU KNOW THAT, BUT YOU STILL STEP INTO{SAUT}MY TERRITORY... ME HAVE BAD FEELING...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0766",
    "en": "  YOU STUPID! IGNORANCE NOT EXCUSE!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0767",
    "en": "  YOU HUMAN. YOU MAKE MISTAKES EASY.{SAUT}BE CAREFUL NEXT TIME...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0768",
    "en": " WE GET ALONG! WE FRIENDS! AWOOO!{SAUT}AWOOO!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0769",
    "en": "YOU NO GOOD! CIRCLE TASTY! YOU NOT{SAUT}UNDERSTAND!{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0770",
    "en": "{PAGE}MOON IS SAD. ME TEACH YOU!(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0771",
    "en": " YOU INDECISIVE! ME NOT INTERESTED IN{SAUT}YOU.(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0772",
    "en": "  TAKING OUT WATERMELON SEEDS IS A{SAUT}PAIN...(*RESPONSE*)",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0773",
    "en": "   ME UNDERSTAND YOUR THOUGHT! ME FORGOT,{SAUT}EVERY MEETING IMPORTANT!{ATTENTE}",
    "fr": ""
  },
  {
    "id": "KEMONO.BIN:text:0774",
    "en": "{PAGE}YOU MY GUEST!(*RESPONSE*)",
    "fr": ""
  },
  {
